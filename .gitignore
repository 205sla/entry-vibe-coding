# Node
node_modules/
# 로그 전반 — npm-debug.log, chromium 이 뱉는 debug.log 등 (커밋 대상 .log 없음)
*.log

# 로컬 npm install 스크래치 — setup 스크립트로 재생성
vendor-install/

# Runtime
temp/
test-results/
playwright-report/

# Setup script cache (cloned fallbacks for external users without siblings)
.setup-cache/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ─── Third-party assets (재구축 가능) ──────────────────────────
# entryjs/dist 복사본 (17MB+)
public/lib/entry-js/dist/
# entryjs/extern 복사본
public/lib/entry-js/extern/
# entryjs/images 복사본 (32MB)
public/lib/entry-js/images/

# entryjs 기원의 public/images/ 전체 제외, 직접 만든 game/blank만 포함
public/images/**

# npm dist 복사본 (preloadjs 패치 포함)
public/lib/vendor/

# cursor 파일 (handclosed/handopen.cur)은 커밋 — 콜드 클론에서도 필요

# ─── External module junctions (링크 타겟 커밋 불가) ──────────
public/lib/entry-tool
public/lib/entry-paint
public/lib/entry-lms
public/lib/sound-editor
public/lib/legacy-video

# ─── 직접 만든 게임 에셋은 유지 ─────────────────────────────
!public/images/blank/
!public/images/blank/**
!public/images/game/
!public/images/game/**
# 205 mascot SVG — 픽스처 8개가 참조, 콜드 클론 재빌드에 필수
!public/images/mascot/
!public/images/mascot/**

# tools/*.mjs 런타임 검증 스크립트가 생성하는 artifact (inspect, verify-*)
tools/inspect-*.png
tools/verify-*.png

# verify / screenshot 도구의 단계별 캡처 디렉토리 (재생성 가능)
tests/output/
tests/fixtures/*-shots/

# ─── 외부에서 받아온 작품 (바이브 코딩 산출물이 아님) ─────────
# games/* 는 이 저장소가 spec 에서 생성한 작품만 커밋한다.
# 아래는 완성된 외부 작품을 개조 베이스로 임포트한 것 — 타인 저작 에셋(이미지·음원)을
# 포함하고 용량도 크므로 공개 저장소에 올리지 않는다. 개조 결과물도 같은 이유로 로컬 전용.
games/shogi/

# 예전 실험 작품 5개 — 개인 로컬 원본(.ent)을 읽어 만들어서 저장소만으로는 다시 만들 수 없고,
# 원본의 이용자 ID·그림이 들어 있어 공개 저장소에서 내렸다 (2026-09-30, 로컬 전용).
# 여기서 나온 엔진 지식(변수 좌표·원형 배치 등)은 knowledge/07 에 남아 있다.
games/bad-apple/
games/clock/
games/coord-test/
games/name-circle/
games/name-row/

# 미완성 작품 — 검사가 다 통과하지 않은 상태라 공개 저장소에서 내렸다 (2026-09-29, 로컬 전용).
# 여기서 나온 일반 지식은 knowledge/04·05·07 에, 도트 그림 도구는 tools/lib/pixel-art.mjs 에 옮겼다.
games/brick-kingdom/

# 하네스(이 저장소 자체)를 고칠 때만 필요한 지식 — 작품을 만드는 사용자에겐 필요 없어 로컬 전용
knowledge/_harness/

# 작품 홍보용 썸네일은 로컬 보관 (사용자 요청)
games/sunset-drive/thumbnail/
games/abyssal-keep/thumbnail/
